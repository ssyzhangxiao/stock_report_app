API_HOST=0.0.0.0
API_PORT=9002
DEBUG=True
CORS_ORIGINS=http://localhost:6003,http://127.0.0.1:6003,http://localhost:5173,http://127.0.0.1:5173

# LLM API 配置（用于 AI 智能分析）
# 支持多供应商自动故障转移，按优先级链检测：
#   DeepSeek > 通义千问(Qwen) > OpenAI > OpenRouter
# 只需配置任意一个有 API Key 的供应商即可自动启用
# 如果 LLM_PROVIDER 为空，系统会自动检测可用供应商

# LLM_PROVIDER=       # 可选: deepseek / qwen / openai / openrouter (留空则自动检测)

# DeepSeek
DEEPSEEK_API_KEY=

# 通义千问 (阿里云 DashScope)
DASHSCOPE_API_KEY=

# OpenAI
# OPENAI_API_KEY=

# OpenRouter (聚合多模型)
# OPENROUTER_API_KEY=
